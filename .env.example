# Copia este archivo a ".env" y rellena tus claves reales.

# Clave de la API de Anthropic (para el ranking con IA).
# Consíguela en https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Bot de Telegram. Habla con @BotFather para crear un bot y obtener el token.
TELEGRAM_BOT_TOKEN=123456:ABC...

# Tu chat ID de Telegram (a dónde se envían las ofertas).
# Para obtenerlo: habla con @userinfobot y te dirá tu ID.
TELEGRAM_CHAT_ID=123456789
